---
import { getEntry } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import PageBlocks from '../components/PageBlocks.astro';

const page = await getEntry('pages', 'home');
---

<BaseLayout
  title="Quansight"
  description="Open source, sustainable, and community-driven AI and data science consulting."
>
  <PageBlocks blocks={page?.data.blocks ?? []} />
</BaseLayout>
