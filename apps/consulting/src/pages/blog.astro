---
import { getCollection, getEntry } from 'astro:content';

import { BlogList } from '../components/Blog/BlogList';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBlocks from '../components/PageBlocks.astro';
import categories from '../../posts/categories.json';

const page = await getEntry('pages', 'blog');

// The converted WP page marks where its posts widgets sat with `posts`
// blocks (nested inside a `columns` row). Live has two: 3 posts, then the
// subscribe panel, then the rest. BlogList is one component, so the
// whole list renders at the first marker's top-level row and the other
// marker's row is dropped.
type Block = Record<string, unknown> & { type: string };
const containsPosts = (block: Block): boolean =>
  block.type === 'posts' ||
  ((block.columns as Block[][] | undefined) ?? []).some((column) =>
    column.some(containsPosts),
  );
const allBlocks = (page?.data.blocks ?? []) as Block[];
const firstPostsIndex = allBlocks.findIndex(containsPosts);
const blocksBefore =
  firstPostsIndex === -1 ? allBlocks : allBlocks.slice(0, firstPostsIndex);
const blocksAfter =
  firstPostsIndex === -1
    ? []
    : allBlocks.slice(firstPostsIndex + 1).filter((b) => !containsPosts(b));
const allPosts = await getCollection('posts');
const allPeople = await getCollection('people');

const peopleBySlug = Object.fromEntries(
  allPeople.map((e) => [e.id, e.data]),
);

const posts = allPosts
  .filter((p) => p.data.published)
  .sort((a, b) => new Date(b.data.published).getTime() - new Date(a.data.published).getTime())
  .map((post) => ({
    id: post.id,
    title: post.data.title,
    published: post.data.published,
    authors: post.data.authors
      .map((s) => {
        const p = peopleBySlug[s];
        return p ? `${p.firstName} ${p.lastName}` : s;
      })
      .join(', '),
    featuredImage: post.data.featuredImage,
    categories: post.data.category,
  }));
---

<BaseLayout
  title={page?.data.seoTitle ?? 'Blog | Quansight'}
  description={page?.data.description}
>
  <PageBlocks blocks={blocksBefore} />

  <div class="pt-[3rem]">
    <BlogList posts={posts} categories={categories} client:load />
  </div>

  {blocksAfter.length > 0 && <PageBlocks blocks={blocksAfter} />}
</BaseLayout>
