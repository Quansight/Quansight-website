---
import { getEntry } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import PageBlocks from '../components/PageBlocks.astro';

// The blog index is a converted WP page like any other; its `posts`
// blocks (see convert_posts in the converter) render the post grid via
// BlockRenderer. Kept as its own route only because [...slug] excludes it.
const page = await getEntry('pages', 'blog');
---

<BaseLayout
  title={page?.data.seoTitle ?? 'Blog | Quansight'}
  description={page?.data.description}
>
  <PageBlocks blocks={page?.data.blocks ?? []} />
</BaseLayout>
