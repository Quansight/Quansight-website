---
import { getEntry } from 'astro:content';

const entry = await getEntry('singletons', 'footer');
const { logo, contact, navigationGroups, socialMedia, legal, copyright } = entry!.data as {
  logo: { src: string; alt: string };
  contact: { title: string; lines: { text: string; href?: string; kind?: string }[] };
  navigationGroups: { title: string; links: { text: string; href: string }[] }[];
  socialMedia: { title: string; links: { text: string; href: string; icon: string; iconAlt: string }[] };
  legal?: { text: string; href: string }[];
  copyright: string;
};
---

<footer class="flex justify-center items-center text-[#efefef] bg-gradient-to-b from-[#452391] to-[#963895]">
  <div class="px-9 pt-24 pb-20 w-full sm:px-16 sm:pb-5 xl:px-52 xl:pt-[6.2rem] xl:pb-[3.7rem] max-w-layout">
    <section class="grid grid-cols-2 gap-[3.2rem] sm:gap-24 lg:grid-cols-5 lg:gap-[3rem] xl:gap-[6rem]">

      {/* logo column */}
      <div class="col-span-2 lg:col-span-1 relative top-0 w-[23.9rem] h-[6.455rem] sm:w-[22.6rem] sm:h-[6.104rem]">
        <img
          src={logo.src}
          alt={logo.alt}
          style="width:100%;height:100%;object-fit:contain;object-position:left"
        />
      </div>

      {/* navigation columns */}
      {navigationGroups.map((group) => (
        <div class="mb-8">
          <h2 class="pb-[1.3rem] mb-4 text-[1.6rem] font-bold leading-[3rem] border-b-[0.5px] border-white">
            {group.title}
          </h2>
          <ul class="flex flex-col">
            {group.links.map((link) => (
              <li class="pb-5 text-[1.4rem] font-normal leading-[2.3rem]">
                <a href={link.href} class="hover:underline">{link.text}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      {/* contact column */}
      <div class="flex flex-col col-span-2 sm:col-span-1">
        <h2 class="mb-4 text-[1.6rem] font-bold leading-[3rem] pb-[1.3rem] border-b-[0.5px] border-white">
          {contact.title}
        </h2>
        <div class="text-[1.4rem] leading-[3.3rem]">
          {contact.lines.map((line) => (
            <p>
              {line.href ? (
                <a href={line.href} class="hover:underline">{line.text}</a>
              ) : (
                line.text
              )}
            </p>
          ))}
        </div>
      </div>

      {/* social media column */}
      <div class="col-span-2 sm:col-span-1">
        <h2 class="pb-[1.3rem] mb-8 text-[1.6rem] font-bold leading-[3rem] border-b-[0.5px] border-white">
          {socialMedia.title}
        </h2>
        <ul class="flex flex-wrap gap-12 lg:gap-8 xl:gap-12">
          {socialMedia.links.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noreferrer" class="block relative w-10 h-10">
                <span class="sr-only">{link.text}</span>
                <img
                  src={link.icon}
                  alt={link.iconAlt}
                  aria-hidden="true"
                  class="w-full h-full object-contain"
                />
              </a>
            </li>
          ))}
        </ul>
      </div>

    </section>

    {/* legal row */}
    {legal && legal.length > 0 && (
      <section class="flex flex-wrap gap-6 pt-8 mt-[3.7rem] border-t-[0.5px] border-white sm:mt-[8.5rem]">
        {legal.map((link) => (
          <a href={link.href} class="text-[1.2rem] leading-[2.4rem] hover:underline">{link.text}</a>
        ))}
      </section>
    )}

    {/* copyright */}
    <section class="pt-8">
      <p class="text-[1.2rem] leading-[2.4rem]">{copyright}</p>
    </section>
  </div>
</footer>
