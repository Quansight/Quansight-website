---
// Rebuilds the WordPress/Elementor newsletter signup form: same fields,
// placeholders and submit label as the live site.
//
// Posts to /api/subscribe, a Vercel serverless function (see
// apps/consulting/api/subscribe.js) that calls the Mailchimp Marketing API
// server-side with an API key -- the key can't live in this component since
// it's rendered into static, public markup. That function needs
// MAILCHIMP_API_KEY and MAILCHIMP_AUDIENCE_ID set in the Vercel project's
// environment variables.

type Field = {
  name: string;
  type?: string;
  required?: boolean;
  placeholder?: string;
};

interface Props {
  name: string;
  fields: Field[];
  submit: string;
  submitIcon?: boolean;
}

const { name, fields, submit, submitIcon } = Astro.props;

const FIELD_CLASS =
  'w-full px-[1.6rem] py-[1.2rem] text-[1.6rem] leading-[2.4rem] text-black bg-white border border-gray-300 placeholder:text-gray-500 focus:outline-none focus:ring-2 focus:ring-violet';
---

<form
  class="flex flex-col gap-[1.6rem] w-full max-w-[52rem]"
  name={name}
  aria-label={name}
  method="post"
  action="/api/subscribe"
  data-mailchimp-form
>
  {fields.map((field) => (
    <input
      id={`field-${field.name}`}
      name={field.name}
      type={field.type ?? 'text'}
      required={field.required}
      placeholder={field.placeholder}
      aria-label={field.placeholder}
      class={FIELD_CLASS}
    />
  ))}

  <button
    type="submit"
    class="flex gap-[0.8rem] justify-center items-center px-[3rem] py-[1.2rem] w-fit text-[1.6rem] font-bold leading-[2.4rem] text-white bg-pink disabled:opacity-60 disabled:cursor-not-allowed"
  >
    {submit}
    {submitIcon && <span aria-hidden="true">➤</span>}
  </button>

  <p data-form-status hidden class="text-[1.3rem] leading-[2rem] text-white" />
</form>

<script>
  // Progressive enhancement: intercept the submit and show an inline
  // result instead of a full-page navigation to the JSON response.
  // Without JS the form still posts to /api/subscribe and the function
  // runs, it just leaves the visitor on a blank JSON page.
  document.querySelectorAll<HTMLFormElement>('form[data-mailchimp-form]').forEach((form) => {
    // Both elements are rendered by this component, so they always exist.
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const status = form.querySelector<HTMLParagraphElement>('[data-form-status]')!;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      button.disabled = true;

      let ok = false;
      let message = 'Something went wrong. Please try again.';
      try {
        // URL-encoded, same as the no-JS post (Vercel doesn't parse multipart bodies).
        const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
        const response = await fetch(form.action, { method: 'POST', body });
        const data = await response.json();
        ok = response.ok;
        message = ok ? 'Thanks for subscribing!' : data.error || message;
      } catch {
        // Network failure or a non-JSON response: keep the generic message.
      }

      status.hidden = false;
      status.dataset.state = ok ? 'success' : 'error';
      status.textContent = message;
      if (ok) form.reset();
      button.disabled = false;
    });
  });
</script>
