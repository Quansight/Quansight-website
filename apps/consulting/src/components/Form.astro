---
// Rebuilds the WordPress/Elementor forms: same fields, placeholders,
// select options and submit labels as the live site.
//
// The newsletter signup (audience="mailchimp") posts to /api/subscribe, a
// Vercel serverless function (see apps/consulting/api/subscribe.js) that
// calls the Mailchimp Marketing API server-side with an API key -- the key
// can't live in this component since it's rendered into static, public
// markup. That function needs MAILCHIMP_API_KEY and MAILCHIMP_AUDIENCE_ID
// set in the Vercel project's environment variables.
//
// CONTACT_ACTION is the services enquiry form, which on WP emailed the team
// rather than going to Mailchimp. It needs its own destination (a form
// service or a serverless handler), not the audience above. Until it's set,
// that form submits to "#" and is marked aria-disabled so a visitor can't
// believe a submission was delivered.
const CONTACT_ACTION = '';

type Field = {
  name: string;
  kind: 'input' | 'textarea' | 'select';
  type?: string;
  required?: boolean;
  placeholder?: string;
  label?: string;
  rows?: number;
  options?: string[];
};

interface Props {
  name: string;
  fields: Field[];
  submit: string;
  audience?: 'mailchimp' | 'contact';
  submitIcon?: boolean;
}

const { name, fields, submit, audience = 'contact', submitIcon } = Astro.props;

const action = audience === 'mailchimp' ? '/api/subscribe' : CONTACT_ACTION;
const isConfigured = audience === 'mailchimp' || action !== '';

const FIELD_CLASS =
  'w-full px-[1.6rem] py-[1.2rem] text-[1.6rem] leading-[2.4rem] text-black bg-white border border-gray-300 placeholder:text-gray-500 focus:outline-none focus:ring-2 focus:ring-violet';
---

<form
  class="flex flex-col gap-[1.6rem] w-full max-w-[52rem]"
  name={name}
  aria-label={name}
  method="post"
  action={isConfigured ? action : '#'}
  aria-disabled={isConfigured ? undefined : 'true'}
  data-audience={audience}
>
  {fields.map((field) => (
    <div class="flex flex-col gap-[0.6rem]">
      {field.label && (
        <label class="text-[1.4rem] font-bold leading-[2rem]" for={`field-${field.name}`}>
          {field.label}
        </label>
      )}
      {field.kind === 'textarea' ? (
        <textarea
          id={`field-${field.name}`}
          name={field.name}
          rows={field.rows ?? 4}
          required={field.required}
          placeholder={field.placeholder}
          class={FIELD_CLASS}
        />
      ) : field.kind === 'select' ? (
        <select id={`field-${field.name}`} name={field.name} required={field.required} class={FIELD_CLASS}>
          <option value="">Select</option>
          {(field.options ?? []).map((option) => (
            <option value={option}>{option}</option>
          ))}
        </select>
      ) : (
        <input
          id={`field-${field.name}`}
          name={field.name}
          type={field.type ?? 'text'}
          required={field.required}
          placeholder={field.placeholder}
          class={FIELD_CLASS}
        />
      )}
    </div>
  ))}

  <button
    type="submit"
    disabled={!isConfigured}
    class="flex gap-[0.8rem] justify-center items-center px-[3rem] py-[1.2rem] w-fit text-[1.6rem] font-bold leading-[2.4rem] text-white bg-pink disabled:opacity-60 disabled:cursor-not-allowed"
  >
    {submit}
    {submitIcon && <span aria-hidden="true">➤</span>}
  </button>

  {!isConfigured && (
    <p class="text-[1.3rem] leading-[2rem] opacity-80">
      Not yet connected — see Form.astro for the endpoint to fill in.
    </p>
  )}

  {audience === 'mailchimp' && (
    <p data-form-status hidden class="text-[1.3rem] leading-[2rem] data-[state=error]:text-red-600 data-[state=success]:text-green-700" />
  )}
</form>

{audience === 'mailchimp' && (
  <script>
    // Progressive enhancement: intercept the submit and show an inline
    // result instead of a full-page navigation to the JSON response.
    // Without JS the form still posts to /api/subscribe and the function
    // runs, it just leaves the visitor on a blank JSON page.
    document.querySelectorAll<HTMLFormElement>('form[data-audience="mailchimp"]').forEach((form) => {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const status = form.querySelector<HTMLParagraphElement>('[data-form-status]');
        const originalLabel = button?.textContent ?? '';
        if (button) {
          button.disabled = true;
          button.textContent = 'Submitting…';
        }

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(Object.fromEntries(new FormData(form))),
          });
          const data = await response.json();

          if (status) {
            status.hidden = false;
            status.dataset.state = response.ok ? 'success' : 'error';
            status.textContent = response.ok
              ? 'Thanks for subscribing!'
              : data.error || 'Something went wrong. Please try again.';
          }
          if (response.ok) form.reset();
        } catch {
          if (status) {
            status.hidden = false;
            status.dataset.state = 'error';
            status.textContent = 'Something went wrong. Please try again.';
          }
        } finally {
          if (button) {
            button.disabled = false;
            button.textContent = originalLabel;
          }
        }
      });
    });
  </script>
)}
