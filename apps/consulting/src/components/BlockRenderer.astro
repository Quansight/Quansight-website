---
import { Hero } from './Hero';
import { PageHeading } from './PageHeading';

interface Props {
  block: Record<string, unknown> & { type: string };
}

const { block } = Astro.props;
---

{block.type === 'hero' && (
  <Hero
    image={block.image as string | undefined}
    imageAlt={(block.imageAlt as string) ?? ''}
    imageDesktop={block.imageDesktop as string | undefined}
    imageTablet={block.imageTablet as string | undefined}
    imageMobile={block.imageMobile as string | undefined}
    objectFitDesktop={block.objectFitDesktop as 'cover' | 'contain' | undefined}
    objectFitTablet={block.objectFitTablet as 'cover' | 'contain' | undefined}
    objectFitMobile={block.objectFitMobile as 'cover' | 'contain' | undefined}
    title={block.title as string | undefined}
    subTitle={block.subTitle as string | undefined}
    variant={(block.variant as 'small' | 'medium' | 'large') ?? 'medium'}
    objectFit={(block.objectFit as 'cover' | 'contain') ?? 'cover'}
  />
)}

{block.type === 'page-heading' && (
  <PageHeading
    title={block.title as string}
    description={block.description as string | undefined}
  />
)}
