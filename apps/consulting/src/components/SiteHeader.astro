---
import { getEntry } from 'astro:content';
import { SiteHeaderMobile } from './SiteHeaderMobile';

type NavItem = { text: string; href: string; children?: NavItem[] };

const entry = await getEntry('singletons', 'header');
const { logo, navigation, skipLinksText } = entry!.data as {
  logo: { src: string; alt: string };
  navigation: NavItem[];
  skipLinksText: string;
};
// Live colors the current page's dropdown entry magenta (WP's
// current-menu-item).
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => href.replace(/\/+$/, '') === currentPath;
---

<header class="fixed inset-x-0 top-0 z-20 bg-black text-white sm:relative sm:z-auto sm:bg-[#331A6C]">
  {/* The live header is its OWN in-flow section before the hero (min-
      height 50px, its own violet background) -- it pushes the hero down,
      it does NOT overlay it transparently (confirmed via the header's own
      CSS: no position:fixed/absolute anywhere, a real background-color).
      The background isn't flat #452392: a full-bleed, solid-black overlay
      image sits over it at 26% opacity (confirmed by sampling the actual
      image -- it's uniformly RGB(1,1,1), no visible pattern at that
      opacity, so reproducing it as an image would look identical to just
      pre-blending the color), darkening it to #331A6C. Mobile keeps this
      fixed/solid, matching SiteHeaderMobile's own
      always-fixed bar. */}
  <div class="mx-auto max-w-layout">
    {/* skip to content link */}
    <div class="absolute inset-x-0 top-0 z-50 py-[2rem] max-w-full text-[1.6rem] font-extrabold text-center text-white bg-black transition-transform duration-300 ease-in-out -translate-y-full focus-within:translate-y-0">
      <a href="#maincontent" class="pb-2 border-b-2">{skipLinksText}</a>
    </div>

    {/* desktop nav -- real per-section padding is 0 beyond the boxed
        1140px width (max-w-layout already provides that), and the logo's
        own column is a narrow ~17.6% of it, not half -- both previously
        guessed too generously, which read as the logo sitting further
        right/larger than the live site. */}
    <div class="hidden gap-[4.7rem] justify-between items-center sm:flex">
      <a href="/" aria-label="Go to home page" class="relative shrink-0 w-[18rem] h-[8.7rem] lg:w-[20rem] lg:h-[9.66rem]">
        <img
          src={logo.src}
          alt={logo.alt}
          style="position:absolute;inset:0;width:100%;height:100%;object-fit:contain"
        />
      </a>
      {/* Live nav items (computed): Inter 16px/600 white, padding 13px
          20px, 1.5px apart, right-aligned; items with a submenu carry an
          11px chevron with 10px left padding. The dropdown is a 156px
          white panel 10px below the item with 14px/500 violet links padded
          10px -- that 10px gap is bridged with padding on an invisible
          wrapper so hovering across it keeps the menu open. */}
      <nav class="flex flex-wrap gap-x-[0.3rem] gap-y-[1.5rem] items-center w-full justify-end">
        {navigation.map((item) => (
          <div class="relative group">
            <a
              href={item.href}
              class="flex items-center px-[2rem] py-[1.3rem] text-[1.6rem] font-semibold leading-[2rem] hover:text-green transition-colors ease-in-out"
              aria-haspopup={item.children ? 'true' : undefined}
            >
              {item.text}
              {item.children && (
                <svg aria-hidden="true" viewBox="0 0 448 512" class="ml-[1rem] w-[1.1rem] h-[1.1rem] fill-current">
                  <path d="M207.029 381.476L12.686 187.132c-9.373-9.373-9.373-24.569 0-33.941l22.667-22.667c9.357-9.357 24.522-9.375 33.901-.04L224 284.505l154.745-154.021c9.379-9.335 24.544-9.317 33.901.04l22.667 22.667c9.373 9.373 9.373 24.569 0 33.941L240.971 381.476c-9.373 9.372-24.569 9.372-33.942 0z" />
                </svg>
              )}
            </a>
            {item.children && (
              <div class="hidden group-hover:block group-focus-within:block absolute left-0 top-full pt-[1rem] z-30">
                <ul class="min-w-[15.6rem] bg-white">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class={`block p-[1rem] text-[1.4rem] font-medium leading-[2rem] ${isCurrent(child.href) ? 'text-pink' : 'text-violet'} whitespace-nowrap hover:text-green transition-colors ease-in-out`}
                        aria-current={isCurrent(child.href) ? 'page' : undefined}
                      >
                        {child.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        ))}
      </nav>
    </div>

    {/* mobile nav (React island) */}
    <SiteHeaderMobile
      logoSrc={logo.src}
      logoAlt={logo.alt}
      navigation={navigation}
      currentPath={currentPath}
      client:load
    />
  </div>
</header>
